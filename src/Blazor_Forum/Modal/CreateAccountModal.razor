@using Application.Users
@using Entities
@inject CreateAccountModalState ModalState
@inject UserService UserService

@if (Visible)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-box" @onclick:stopPropagation="true">

            <div class="modal-header">
                <span class="cb-keyword">create account</span>
                <button class="modal-close" @onclick="Close">
                    &times
                </button>
            </div>

            <div class="modal-compose">
                <input class="compose-name"
                       placeholder="username"
                       @bind="Username" />
                <input class="compose-name"
                       type="password"
                       placeholder="password"
                       @bind="Password" />
                <input class="compose-name"
                       type="password"
                       placeholder="confirm password"
                       @bind="ConfirmPassword" />

                <button class="cb-btn cb-btn-primary"
                        @onclick="Submit"
                        disabled="@IsDisabled">
                    create account
                </button>

            </div>
        </div>
    </div>
}
@code 
{
    ApplicationUser _applicationUser = new ApplicationUser();

    string Username = "";
    string Password = "";
    string ConfirmPassword = "";

    bool IsDisabled =>
        string.IsNullOrWhiteSpace(Password)
        || Password != ConfirmPassword;

    public bool Visible { get; private set; }

    protected override void OnInitialized()
    {
        ModalState.OnShow += Open;
        ModalState.OnClose += Close;
    }

    void Open()
    {
        Visible = true;
        StateHasChanged();
    }
    void Close()
    {
        Visible = false;
        StateHasChanged();
    }

    private void Submit()
    {
        // 1. Kolla att Password == ConfirmPassword
        // 2. Anropa din service
        // 3. Navigera eller visa bekräftelse
        
        UserService.CreateUser(Username, Password);
        Close();
        
    }

    public void Dispose()
    {
        ModalState.OnShow -= Open;
        ModalState.OnClose -= Close;
    }

}