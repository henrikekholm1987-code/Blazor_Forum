@using Application.Users
@using Entities
@inject CreateAccountModalState ModalState
@inject UserService UserService
@implements IDisposable

@if (Visible)
{
    <div class="create-account-modal-backdrop" @onclick="Close">
        <div class="create-account-modal-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="create-account-title"
             @onclick:stopPropagation="true">

            <div class="create-account-modal-header">
                <span id="create-account-title" class="cb-keyword">create account</span>
                <button class="create-account-modal-close" type="button" @onclick="Close" aria-label="Close create account modal">
                    &times;
                </button>
            </div>

            <div class="create-account-modal-body">
                <input class="create-account-input"
                       placeholder="username"
                       @bind="Username" />
                <input class="create-account-input"
                       type="password"
                       placeholder="password"
                       @bind="Password" />
                <input class="create-account-input"
                       type="password"
                       placeholder="confirm password"
                       @bind="ConfirmPassword" />

                <button class="cb-btn cb-btn-primary create-account-submit"
                        @onclick="Submit"
                        disabled="@IsDisabled">
                    create account
                </button>

            </div>
        </div>
    </div>
}
@code 
{
    ApplicationUser _applicationUser = new ApplicationUser();

    string Username = "";
    string Password = "";
    string ConfirmPassword = "";

    bool IsDisabled =>
        string.IsNullOrWhiteSpace(Password)
        || Password != ConfirmPassword;

    public bool Visible { get; private set; }

    protected override void OnInitialized()
    {
        ModalState.OnShow += Open;
        ModalState.OnClose += Close;
    }

    void Open()
    {
        Visible = true;
        StateHasChanged();
    }
    void Close()
    {
        Visible = false;
        StateHasChanged();
    }

    private void Submit()
    {
        // 1. Kolla att Password == ConfirmPassword
        // 2. Anropa din service
        // 3. Navigera eller visa bekräftelse
        
        UserService.CreateUser(Username, Password);
        Close();
        
    }

    public void Dispose()
    {
        ModalState.OnShow -= Open;
        ModalState.OnClose -= Close;
    }

}