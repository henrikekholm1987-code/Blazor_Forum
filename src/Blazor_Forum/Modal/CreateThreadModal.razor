@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Application.ServiceLocator
@using Entities

@inject ThreadServices ThreadServices
@inject Forum Forum;

@if (CreationOfThread)
{
    <div class="modal-backdrop" @onclick="DeleteThread">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div>
                <div class="modal-header">
                    
                    <span class="cb-keyword">topic:</span>
                    
                    <textarea class="compose-text"
                      rows="2"
                      @bind="NewThreadTitle">
                    </textarea>
                    
                    <button class="modal-close" @onclick="DeleteThread">&times; </button>
                    
                </div>
                <div class="modal-compose">
                        
                    <textarea class="compose-text"
                              rows="2"
                              placeholder="text of topic..."
                              @bind="NewThreadContent">
                    </textarea>

                    <button class="cb-btn cb-btn-primary"
                            @onclick="PostThread"
                            disabled="@IsThreadPostDisabled">
                        &#9654; post thread
                    </button>


                </div>
            </div>
        </div>
    </div>
}

@code
{
    string NewThreadTitle = "";
    string NewThreadContent = "";
    
    public bool CreationOfThread { get; set; }
    
    bool IsThreadPostDisabled =>
        string.IsNullOrWhiteSpace(NewThreadTitle) ||
        string.IsNullOrWhiteSpace(NewThreadContent);
    
    // protected override async Task OnInitializedAsync()

    protected override void OnInitialized()
    {
        Forum.OnCreateThreadItem += CreateThread;
    }

    void DeleteThread()
    {
      
    }

    

    void CreateThread()
    {
        Console.WriteLine("Creating thread");
        CreationOfThread = true;
        NewThreadTitle = "";
        NewThreadContent = "";
        
    }

     async Task PostThread()
    {
        var thread = new ThreadItem
        {
            Title = NewThreadTitle,
            ThreadContent = NewThreadContent
        };

        try
        {
            var created = await ThreadServices.CreateThreadAsync(thread);
            CreationOfThread = false;
            NewThreadTitle = "";
            NewThreadContent = "";
        }
        catch (ArgumentException ex)
        {
            Console.WriteLine($"Validation error: {ex.Message}");
            
        }
    }
    
}