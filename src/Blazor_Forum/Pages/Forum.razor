    void PostThread()
    {
        if (IsThreadPostDisabled) return;
    
        var nextThreadId = ActiveThreads.Count == 0 ? 1 : ActiveThreads.Max(t => t.ThreadId) + 1;
        
        var newThread = new ThreadItem
        {
            ThreadId = nextThreadId,
            Title = NewThreadTitle.Trim(),
            ThreadContent = NewThreadContent.Trim(),
            CreatedAt = DateTime.Now,
            Comments = new List<Comment>()
        };
    
        ActiveThreads.Insert(0, newThread);
        ActiveThread = newThread;
        NewThreadTitle = "";
        NewThreadContent = "";
        creationOfThread = false;
    }

    void PostComment()
    {
        if (ActiveThread is null ) return;

        ActiveThread.Comments.Add(new Comment
        {
            Content = NewCommentText.Trim(),
            CreatedAt = DateTime.Now
        });

        NewCommentText = "";
    }

    string GetInitials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }
    
    #endregion
}