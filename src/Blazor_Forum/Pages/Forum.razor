@page "/forum"

@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

@inject AuthService AuthServices

@inject ApplicationUserService UserService
@inject ThreadServices ThreadServices

@using Microsoft.AspNetCore.Components.Authorization
@using Application.Auth
@using Application.ServiceLocator

@using Entities

<PageTitle>Forum</PageTitle>

<div class="home-wrapper">
       <p class="home-subtitle">
        User logged in:
    <NavLink href="@($"/user/{currentUser?.ApplicationUserId}")">
        @currentUser?.UserName
    </NavLink>
    </p>
    
    <h1 class="home-title">Forum</h1>
    <p class="home-subtitle">
        The discussions listed below are arranged in no particular order.
        Some may be useful.
        Others may simply exist.
    </p>

    <div class="cb-card">

        <div class="cb-card-header">
            <span class="cb-keyword">threads</span>
        </div>

        <div class="threads-carousel">
           
            @foreach (var thread in ActiveThreads)
            {
                <div class="cb-thread" @onclick="() => OpenThread(thread)">
                    <span class="cb-keyword">topic:</span>
                    <span class="cb-thread-title">@thread.Title</span>
                </div>
            }
            
        </div>

        <div class="cb-actions">
            
            <button class="cb-btn cb-btn-primary" @onclick="CreateThread">
                &#9654; new thread
            </button>
            @if(IsCurrentUserAdmin)
            {
                <button class = "cb-btn cb-btn-primary" @onclick="Dashboard">
                &#9654; dashboard
            </button>

            }
             
        </div>

    </div>

    <div class="cb-canvas">
        <div class="cb-block">
            <span class="cb-keyword">if</span>
            something should be discussed:
            <div class="cb-announce">
                <span class="cb-keyword">then</span>
                <span class="cb-string">"create a thread"</span>
            </div>
            <div class="cb-else-label">else:</div>
            <div class="cb-announce">
                <span class="cb-keyword">then</span>
                <span class="cb-string">"observe existing threads"</span>
            </div>
        </div>
    </div>
</div>

@if (creationOfThread is true)
{
    <div class="modal-backdrop" @onclick="DeleteThread">
        <div class="modal-box" @onclick:stopPropagation="true">

            <div class="modal-header">
                <div>
                    <span class="cb-keyword">topic:</span>
                    <span class="modal-title">new thread</span>
                </div>
                <button class="modal-close" @onclick="DeleteThread">&times;</button>
            </div>

            <div class="modal-comments">
                <textarea class="compose-text"
                          rows="2"
                          placeholder="topic title..."
                          @bind="NewThreadTitle">
                </textarea>
            </div>

            <div class="modal-compose">
                 
               

                <div class="compose-row">
                    <button class="cb-btn cb-btn-primary"
                            @onclick="PostThread"
                            disabled="@IsThreadPostDisabled">
                        &#9654; post thread
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@if (ActiveThread is not null)
{
    <div class="modal-backdrop" @onclick="CloseThread">
        <div class="modal-box" @onclick:stopPropagation="true">

                        <div class="modal-header">
                <div>
                    <span class="cb-keyword">topic:</span>
                    @if (editingThread)
                    {
                        <input class="compose-text" @bind="EditThreadTitle" />
                    }
                    else
                    {
                        <span class="modal-title">@ActiveThread.Title</span>
                    }
                </div>

                @if (IsAdmin(ActiveThread.ApplicationUser))
                {
                    @if (editingThread)
                    {
                        <button class="cb-btn cb-btn-primary" @onclick="SaveThreadEdit">spara</button>
                        <button class="cb-btn" @onclick="CancelEditThread">avbryt</button>
                    }
                    else
                    {
                        <button class="cb-btn cb-btn-mini" @onclick="StartEditThread">redigera</button>
                        <button class="cb-btn cb-btn-mini" @onclick="DeleteThreadClick">ta bort</button>
                    }
                }
                <button class="modal-close" @onclick="CloseThread">&times;</button>
            </div>

            @if (editingThread)
            {
                <div class="modal-compose">
                    <textarea class="compose-text" rows="2" @bind="EditThreadContent"></textarea>
                </div>
            }

            <div class="modal-comments">
                
                @if (ActiveThread.Comments is null || !ActiveThread.Comments.Any())
                {
                    <p class="modal-empty">No comments yet. Be the first.</p>
                }
                 @foreach (var comment in ActiveThread.Comments)
                {
                    <div class="modal-comment">
                        <div class="comment-meta">
                            <div class="comment-avatar">@GetInitials(comment.ApplicationUser?.UserName??"?")</div>
                            <span class="comment-author">@comment.ApplicationUser?.UserName</span>
                            <span class="comment-date">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>

                            @if (IsAdmin(comment.ApplicationUser))
                            {
                                <button class="cb-btn cb-btn-mini" @onclick="() => StartEditComment(comment)">redigera</button>
                                <button class="cb-btn cb-btn-mini" @onclick="() => DeleteCommentClick(comment)">ta bort</button>
                            }
                        </div>

                        @if (editingCommentId == comment.CommentId)
                        {
                            <textarea class="compose-text" rows="2" @bind="EditCommentText"></textarea>
                            <div class="compose-row">
                                <button class="cb-btn cb-btn-mini cb-btn-primary" @onclick="() => SaveCommentEdit(comment)">spara</button>
                                <button class="cb-btn cb-btn-mini" @onclick="CancelEditComment">avbryt</button>
                            </div>
                        }
                        else
                        {
                            <p class="comment-body">@comment.Content</p>
                        }
                    </div>
                }
            </div>
            <div class="modal-compose">

    <textarea class="compose-text"
              rows="2"
              placeholder="Add a comment..."
              @bind="NewCommentText">
    </textarea>

    <div class="compose-row">
        <button class="cb-btn cb-btn-primary"
                @onclick="PostComment"
                disabled="@IsCommentPostDisabled">
            &#9654; post comment
        </button>
    </div>
</div>
   </div>    
   </div>
}



@code {

    int? editingCommentId;
    string EditCommentText = "";

    bool editingThread;
    string EditThreadTitle = "";
    string EditThreadContent = "";

    
    bool IsCurrentUserAdmin => currentUser?.Role == "Admin";

    bool IsAdmin(ApplicationUser? owner)
    {
        return owner is not null && currentUser is not null &&
            (owner.ApplicationUserId == currentUser.ApplicationUserId || currentUser.Role == "Admin");
    }

    void StartEditComment(Comment comment)
    {
        editingCommentId = comment.CommentId;
        EditCommentText = comment.Content;
    }

    void CancelEditComment()
    {
        editingCommentId = null;
        EditCommentText = "";
    }

    async Task SaveCommentEdit(Comment comment)
    {
        if (currentUser is null || string.IsNullOrWhiteSpace(EditCommentText))
            return;

        try
        {
            await ThreadServices.UpdateCommentAsync(comment.CommentId, EditCommentText, currentUser);
            ActiveThreads = ThreadServices.GetAllThreads();
            ActiveThread = ActiveThreads.First(t => t.ThreadId == ActiveThread!.ThreadId);
            CancelEditComment();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kunde inte spara kommentar: {ex.Message}");
        }
    }

    async Task DeleteCommentClick(Comment comment)
    {
        if (currentUser is null)
            return;

        try
        {
            await ThreadServices.DeleteCommentAsync(comment.CommentId, currentUser);
            ActiveThreads = ThreadServices.GetAllThreads();
            ActiveThread = ActiveThreads.First(t => t.ThreadId == ActiveThread!.ThreadId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kunde inte ta bort kommentar: {ex.Message}");
        }
    }

    void StartEditThread()
    {
        if (ActiveThread is null) return;
        editingThread = true;
        EditThreadTitle = ActiveThread.Title;
        EditThreadContent = ActiveThread.ThreadContent;
    }

    void CancelEditThread()
    {
        editingThread = false;
    }

    async Task SaveThreadEdit()
    {
        if (ActiveThread is null || currentUser is null)
            return;

        try
        {
            await ThreadServices.UpdateThreadAsync(ActiveThread.ThreadId, EditThreadTitle, EditThreadContent, currentUser);
            ActiveThreads = ThreadServices.GetAllThreads();
            ActiveThread = ActiveThreads.First(t => t.ThreadId == ActiveThread.ThreadId);
            editingThread = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kunde inte spara tråd: {ex.Message}");
        }
    }

    async Task DeleteThreadClick()
    {
        if (ActiveThread is null || currentUser is null)
            return;

        try
        {
            await ThreadServices.DeleteThreadAsync(ActiveThread.ThreadId, currentUser);
            ActiveThreads = ThreadServices.GetAllThreads();
            ActiveThread = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kunde inte ta bort tråd: {ex.Message}");
        }
    }
    

    ThreadItem? ActiveThread;

        [Inject]
    public required NavigationManager Nav { get; set; }

    public Action? OnCreateThreadItem;  
    
    bool creationOfThread;
    
    string NewThreadTitle = "";
    string NewThreadContent = "";
    
    string NewCommentText = "";
    string NewCommentAuthor = "";

    bool IsCommentPostDisabled =>
        string.IsNullOrWhiteSpace(NewCommentText) ||
        currentUser is null;

    bool IsThreadPostDisabled =>
        string.IsNullOrWhiteSpace(NewThreadTitle);
   
        
    List<ThreadItem> ActiveThreads = new();

        [CascadingParameter]
        private Task<AuthenticationState>? AuthState { get; set; }

        ApplicationUser? currentUser;

        protected override async Task OnInitializedAsync()
        {
            ActiveThreads = ThreadServices.GetAllThreads();

            if (AuthState is not null)
            {
                var authState = await AuthState;
                var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (idClaim is not null && int.TryParse(idClaim, out var userId))
                {
                    currentUser = UserService.GetUserById(userId);
                }
            }
        }

        void Dashboard()
        {
            Nav.NavigateTo("/dashboard");
        }

        void CreateThread()
        {
            NewThreadTitle = "";
            NewThreadContent = "";
            creationOfThread = true;
        }
   
   
        void CreateThreadItem( ) 
        {
            OnCreateThreadItem?.Invoke();
        }

        void DeleteThread()
        {
            creationOfThread = false;
        }

        void OpenThread(ThreadItem thread)
        {
            ActiveThread = thread;
            NewCommentText = "";
            NewCommentAuthor = "";  
        }

        void CloseThread()
        {
            ActiveThread = null;
        }
        async Task PostThread()
        {
            if (IsThreadPostDisabled)
                return;

            var newThread = new ThreadItem
            {
                Title = NewThreadTitle.Trim(),
                ThreadContent = NewThreadContent.Trim(),
                CreatedAt = DateTime.Now,
                ApplicationUser = currentUser,
                Comments = new List<Comment>()
            };

            try
            {
                await ThreadServices.CreateThreadAsync(newThread);
                ActiveThreads = ThreadServices.GetAllThreads();
                ActiveThread = ActiveThreads.First(t => t.ThreadId == newThread.ThreadId);

                NewThreadTitle = "";
                NewThreadContent = "";
                creationOfThread = false;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"FEEL vid trådskapande: {ex.GetType().Name}: {ex.Message}");
        
                if (ex.InnerException != null) Console.WriteLine($"Inner: {ex.InnerException.Message}");
            }
        }

        async Task PostComment()
        {
            if (ActiveThread is null || IsCommentPostDisabled)
                return;

            var newComment = new Comment
            {
                Content = NewCommentText.Trim(),
                CreatedAt = DateTime.Now,
                ApplicationUser = currentUser,
                ThreadItem = ActiveThread
            };

            try
            {
                await ThreadServices.CreateCommentAsync(newComment);
                ActiveThreads = ThreadServices.GetAllThreads();
                ActiveThread = ActiveThreads.First(t => t.ThreadId == ActiveThread.ThreadId);

                NewCommentText = "";
            }
            catch (ArgumentException ex)
            {
                Console.WriteLine($"Validation error: {ex.Message}");
            }
        }

    string GetInitials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        
        return parts.Length >= 2? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }
}