@page "/user/{UserId}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Application.ServiceLocator
@using Entities

@inject ApplicationUserService UserService

<PageTitle>Profil</PageTitle>

<div class="home-wrapper">

    @if (profileUser is null)
    {
        <p class="home-subtitle">Användaren hittades inte.</p>
    }
    else
    {
        <h1 class="home-title">@profileUser.UserName</h1>
        <p class="home-subtitle">
            Roll: @profileUser.Role &middot;
            @profileUser.Threads.Count trådar &middot;
            @profileUser.Comments.Count kommentarer
        </p>

        <div class="cb-card">
            <div class="cb-card-header">
                <span class="cb-keyword">trådar</span>
            </div>

            @if (!profileUser.Threads.Any())
            {
                <p class="modal-empty">Inga trådar än.</p>
            }
            else
            {
                <ul class="cb-list">
                    @foreach (var thread in profileUser.Threads)
                    {
                        <li class="cb-thread">
                            <span class="cb-keyword">topic:</span>
                            <span class="cb-thread-title">@thread.Title</span>
                        </li>
                    }
                </ul>
            }
        </div>
    }

    <div class="cb-actions" style="margin-top: 1rem;">
        <button class="cb-btn cb-btn-primary" @onclick="Back">
            &#9654; back to forum
        </button>
    </div>

</div>

@code {
    [Parameter]
    public string? UserId { get; set; }

    [Inject]
    public required NavigationManager Nav { get; set; }

    ApplicationUser? profileUser;

    protected override void OnParametersSet()
    {
        if (UserId is not null && int.TryParse(UserId, out var id))
        {
            profileUser = UserService.GetUserDetails(id);
        }
    }

    void Back()
    {
        Nav.NavigateTo("/forum");
    }
}