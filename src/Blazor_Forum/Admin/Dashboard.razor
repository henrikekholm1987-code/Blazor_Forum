@page "/dashboard"

@using Application.ServiceLocator
@using Entities
@layout Layout.AdminLayout

@inject ApplicationUserService ApplicationUserService

<main class="home-wrapper">
    <header>
        <h1 class="home-title">Dashboard</h1>
    </header>

    <section class="cb-card">

        <header class="cb-card-header">
            <span class="cb-keyword">applications</span>
        </header>

        <ul class="cb-list">

            @foreach (var applicationUser in users)
            {
                <li class="cb-thread" @onclick="() => OpenAuthor(applicationUser
                )">
                    <span class="cb-keyword">ApplicationUser</span>
                    <span class="cb-thread-title">@applicationUser.UserName</span>
                    <span class="cb-thread-title">@applicationUser.Threads.Count.ToString()</span>
                    <button class="cb-modal-close"
                            @onclick="() => DeleteAuthor(applicationUser)">✕
                    </button>
                </li>
            }
        </ul>
    </section>
</main>

@code 
{
    public required ApplicationUser applicationUser {get; set;} // @attribute [Authorize(Roles = "Admin")]
    
    private List <ApplicationUser> users = new();
    
    protected override void OnInitialized()
    {
        users = ApplicationUserService.GetAllUsers();
    }
    
    void OpenAuthorThread(ApplicationUser applicationUser)
    {
        foreach (var thread in users)
        {
            Console.WriteLine(thread);
            Console.WriteLine(applicationUser.Threads.Count.ToString());
        }
    }

    void OpenAuthor(ApplicationUser applicationUser)
    {
        applicationUser.ApplicationUserId = applicationUser.ApplicationUserId;
       OpenAuthorThread(applicationUser);
    }

    void DeleteAuthor(ApplicationUser applicationUser)
    {
        users.Remove(applicationUser);
        ApplicationUserService.DeleteAuthor(applicationUser);
    }
  
}