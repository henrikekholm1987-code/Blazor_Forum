@page "/"

@using Application.Users
@using Entities

@inject UserService UserService


<div class="home-wrapper">
    <h1 class="home-title">Dashboard</h1>
    
    <div class="cb-card">

        <div class="cb-card-header">
            <span class="cb-keyword">threads</span>
        </div>

        @foreach (var author in users)
        {
            <div class="cb-thread" @onclick="() => OpenAuthor(author)">
                <span class="cb-keyword">ApplicationUser</span>
                <span class="cb-thread-title">@author.UserName</span>
            </div>
        }

    </div>
    
    <div class="cb-card">

        <div class="cb-card-header">
            <span class="cb-keyword">threads</span>
        </div>
        
    </div>

    <div class="cb-canvas">
        <div class="cb-block">
            <span class="cb-keyword">if</span> you have an account:
            <div class="cb-announce">
                <span class="cb-keyword">then</span>
                <span class="cb-string">"login"</span>
            </div>
            <div class="cb-else-label">else:</div>
            <div class="cb-announce">
                <span class="cb-keyword">then</span>
                <span class="cb-string">"create a new account"</span>
            </div>
        </div>
    </div>
</div>


@code 
{
    ApplicationUser _author {get; set;}
    
    private List <ApplicationUser> users = new();
    
    protected override void OnInitialized()
    {
        users = UserService.GetAllUsers();
    }

    void OpenAuthor(ApplicationUser author)
    {
        author.ApplicationUserId = author.ApplicationUserId;
    }
    private async Task LoginButton()
    {
        //Nav.NavigateTo("/forum");
        
    }
}