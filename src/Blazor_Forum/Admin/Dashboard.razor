@page "/dashboard"

@using Application.Users
@using Entities
@using Microsoft.AspNetCore.Authorization

@layout Layout.AdminLayout
@inject UserService UserService


<div class="home-wrapper">
    <h1 class="home-title">Dashboard</h1>
    
    <div class="cb-card">
        <div class="cb-card-header">
            <span class="cb-keyword">applications</span>
            
            @foreach (var appuser in users)
            {
                <div class="cb-thread" @onclick="() => OpenAuthor(appuser)">
                    <span class="cb-keyword">ApplicationUser</span>
                    <span class="cb-thread-title">@appuser.UserName</span>
                    <span class="cb-modal-close" @onclick="() => DeleteAuthor(appuser)">✕</span>
                </div>
            }
        </div>
    </div>
</div>

@code 
{
    ApplicationUser _author {get; set;} // @attribute [Authorize(Roles = "Admin")]
    
    private List <ApplicationUser> users = new();
    
    protected override void OnInitialized()
    {
        users = UserService.GetAllUsers();
    }

    void OpenAuthor(ApplicationUser author)
    {
        author.ApplicationUserId = author.ApplicationUserId;
    }

    void DeleteAuthor(ApplicationUser author)
    {
        users.Remove(author);
        UserService.DeleteAuthor(author);
    }
  
}