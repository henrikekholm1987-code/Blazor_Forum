@page "/dashboard"

@attribute [Authorize(Roles = "Admin")]
@using Application.ServiceLocator
@using Entities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@layout Layout.AdminLayout

@inject ApplicationUserService ApplicationUserService
@inject Application.Auth.AuthService AuthServices

<main class="home-wrapper">

    <header>
        <h1 class="home-title">Dashboard</h1>
    </header>

    @if (isAdmin)
    {
        <section class="cb-card">

            <header class="cb-card-header">
                <span class="cb-keyword">applications</span>
            </header>

            <ul class="cb-list">

                @foreach (var applicationUser in users)
                {
                    <li class="cb-thread" @onclick="() => OpenAuthor(applicationUser)">
                        <span class="cb-keyword">ApplicationUser</span>
                        <span class="cb-thread-title">@applicationUser.UserName</span>
                        <span class="cb-thread-title">@(applicationUser.Threads?.Count.ToString() ?? "0")</span>
                        <button class="cb-modal-close" @onclick="() => DeleteAuthor(applicationUser)" @onclick:stopPropagation>✕</button>
                    </li>
                }
            </ul>
        </section>
    }
    else
    {
        <div class="cb-card" style="padding: 20px; text-align: center;">
            <span class="cb-keyword">Nekat tillträde</span>
            <p>Du måste vara inloggad som administratör för att se denna sida.</p>
            <a href="/forum" class="cb-btn cb-btn-primary" style="text-decoration: none; display: inline-block; margin-top: 10px;">Tillbaka till forumet</a>
        </div>
    }
</main>

@code 
{
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private List<ApplicationUser> users = new();
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var authState = await AuthState;
            isAdmin = authState.User.IsInRole("Admin");
        }

        users = ApplicationUserService.GetAllUsers() ?? new();
    }

    void OpenAuthorThread(ApplicationUser applicationUser)
    {
        if (applicationUser.Threads != null)
        {
            foreach (var thread in users)
            {
                Console.WriteLine(thread);
                Console.WriteLine(applicationUser.Threads.Count.ToString());
            }
        }
    }

    void OpenAuthor(ApplicationUser applicationUser)
    {
        OpenAuthorThread(applicationUser);
    }

    void DeleteAuthor(ApplicationUser applicationUser)
    {
        users.Remove(applicationUser);
        ApplicationUserService.DeleteAuthor(applicationUser);
    }
}
