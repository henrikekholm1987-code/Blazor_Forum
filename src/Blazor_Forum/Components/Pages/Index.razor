<style>

.cb-thread {
    padding: 10px 12px;
    border: 1.5px solid #2c2c2a;
    border-radius: 6px;
    background: white;
    margin-bottom: 8px;
    cursor: pointer;
}

.cb-thread:hover {
    background: #efeee9;
}

.cb-thread-title {
    margin-left: 6px;
    color: #2c2c2a;
}

/* Modal */

.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
}

.modal-box {
    background: white;
    border-radius: 12px;
    border: 0.5px solid #d3d1c7;
    width: 100%;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.modal-header {
    padding: 14px 16px 12px;
    border-bottom: 0.5px solid #d3d1c7;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.modal-title {
    font-size: 15px;
    font-weight: 500;
    margin-left: 6px;
    color: #2c2c2a;
}

.modal-close {
    background: none;
    border: none;
    font-size: 20px;
    color: #888780;
    cursor: pointer;
    line-height: 1;
    padding: 0 2px;
}

.modal-close:hover {
    color: #2c2c2a;
}

.modal-comments {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 280px;
    overflow-y: auto;
}

.modal-empty {
    font-size: 14px;
    color: #888780;
    margin: 0;
}

.modal-comment {
    background: #f1efe8;
    border-radius: 8px;
    padding: 10px 12px;
}

.comment-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 5px;
}

.comment-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #CECBF6;
    color: #3C3489;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 500;
    flex-shrink: 0;
}

.comment-author {
    font-size: 13px;
    font-weight: 500;
    color: #2c2c2a;
}

.comment-date {
    font-size: 12px;
    color: #888780;
}

.comment-body {
    margin: 0;
    font-size: 14px;
    color: #2c2c2a;
    line-height: 1.5;
}

.modal-compose {
    padding: 12px 16px;
    border-top: 0.5px solid #d3d1c7;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.compose-text {
    width: 100%;
    box-sizing: border-box;
    resize: none;
    font-size: 14px;
    border: 0.5px solid #b4b2a9;
    border-radius: 8px;
    padding: 8px 10px;
    font-family: inherit;
    color: #2c2c2a;
}
.compose-headline {
    width: 80%;
    resize: none;
    font-size: 14px;
    border-radius: 8px;
    padding: 8px 10px;
    font-family: inherit;
    color: #2c2c2a;
}


.compose-row {
    display: flex;
    align-items: center;
    gap: 8px;
}

.compose-name {
    width: 140px;
    font-size: 13px;
    padding: 6px 10px;
    border: 0.5px solid #b4b2a9;
    border-radius: 8px;
    font-family: inherit;
    color: #2c2c2a;
}

</style>

<CreateAccountModal/>

@code 
{
    [Inject]
    
    NavigationManager Nav { get; set; }
    
    private void OnCreateAccount() => ModalState.Show();
    
    private void LoginButton() => Nav.NavigateTo("/forum");
    
}