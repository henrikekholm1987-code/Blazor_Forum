@page "/"

@rendermode InteractiveServer

<PageTitle>Forum</PageTitle>

<div class="home-wrapper">

    <h1 class="home-title">Blazor Forum</h1>
    
    <p class="home-subtitle"> 
        The content posted on this forum is the responsibility of the individuals involved.
        Out of respect for common sense, the details are left unchanged.

        Cookies may be used to improve your experience and maintain security.
        No one has objected so far.

        By creating an account, you agree to receive essential service messages.
        We expect everything to go just fine.</p> 

    <!-- Login-kort -->
    <div class="cb-card">
        <div class="cb-card-header">
            <span class="cb-keyword">login</span>
        </div>

        <div class="cb-field-group">
            <label class="cb-label">username:</label>
            <input class="cb-input" type="text" placeholder="your username" />
        </div>

        <div class="cb-field-group">
            <label class="cb-label">password:</label>
            <input class="cb-input" type="password" placeholder="••••••••" />
        </div>

        <div class="cb-actions">
            <button class="cb-btn cb-btn-primary" @onclick="LoginButton">  &#9654; Login</button>
            <button class="cb-btn cb-btn-secondary" @onclick="CreateAccount"> Create account</button>
            
        </div>
    </div>

    <!-- Info-block -->
    <div class="cb-canvas">
        <div class="cb-block">
            <span class="cb-keyword">if</span> you have an account:
            <div class="cb-announce">
                <span class="cb-keyword">then</span>
                <span class="cb-string">"login"</span>
            </div>
            <div class="cb-else-label">else:</div>
            <div class="cb-announce">
                <span class="cb-keyword">then</span>
                <span class="cb-string">"create a new account"</span>
            </div>
        </div>
    </div>

</div>

<style>



    .home-wrapper {
        font-family: 'Courier New', Courier, monospace;
        max-width: 480px;
        margin: 2rem auto;
        padding: 1.5rem;
    }

    .cb-card {
        background: #f5f4f0;
        border-radius: 12px;
        padding: 1.25rem;
    }
    

    .home-title {
        font-family: Georgia, serif;
        font-size: 28px;
        font-weight: normal;
        color: #2c2c2a;
        margin-bottom: 0.25rem;
    }

    .home-subtitle {
        font-family: Georgia, serif;
        font-size: 14px;
        color: #666;
        margin-bottom: .1rem;
    }
    
    

    .cb-card-header {
        font-size: 15px;
        font-weight: 700;
        color: #2c2c2a;
        margin-bottom: 1rem;
        border-bottom: 1.5px solid #ddd;
        padding-bottom: 8px;
    }

    .cb-field-group {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .cb-label {
        font-size: 13px;
        color: #555;
        min-width: 90px;
    }

    .cb-input {
        font-family: 'Courier New', Courier, monospace;
        font-size: 13px;
        flex: 1;
        padding: 7px 10px;
        border: 1.5px solid #2c2c2a;
        border-radius: 5px;
        background: white;
        color: #2c2c2a;
        outline: none;
    }

    .cb-input:focus {
        border-color: #555;
        box-shadow: 0 0 0 2px rgba(0,0,0,0.08);
    }

    /* Canvas / block-sektion */
    .cb-canvas {
        border: 2px dashed #aaa;
        border-radius: 8px;
        padding: 12px;
        background: #f5f4f0;
        margin-bottom: 1rem;
    }

    .cb-block {
        background: white;
        border: 2px solid #2c2c2a;
        border-radius: 6px;
        padding: 10px 12px;
        font-size: 14px;
        color: #2c2c2a;
    }

    .cb-announce {
        background: #e8e7e2;
        border: 1.5px solid #2c2c2a;
        border-radius: 5px;
        padding: 7px 12px;
        margin-top: 8px;
        font-size: 14px;
    }

    .cb-else-label {
        font-size: 14px;
        color: #2c2c2a;
        margin-top: 8px;
    }

    .cb-keyword { font-weight: 700; }
    .cb-string { color: #555; }

    /* Knappar */
    .cb-actions {
        display: flex;
        gap: 10px;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .cb-btn {
        font-family: 'Courier New', Courier, monospace;
        font-size: 14px;
        padding: 9px 18px;
        border-radius: 6px;
        cursor: pointer;
        border: none;
        font-weight: 600;
        transition: opacity 0.15s;
    }

    .cb-btn:hover { opacity: 0.85; }
    .cb-btn-primary { background: #1a1a1a; color: white; }
    .cb-btn-secondary { background: white; color: #1a1a1a; border: 1.5px solid #aaa; }
</style>

@code {
    [Inject]
    NavigationManager Nav { get; set; }
    private void LoginButton()
    {
        Nav.NavigateTo("/forum");
    }

    private void CreateAccount()
    {
        
    }
    

}